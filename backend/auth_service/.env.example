# Copy to .env and replace every example secret before starting the stack.
AUTH_DB_USERNAME=auth_service
AUTH_DB_PASSWORD=change-this-database-password
AUTH_DB_ROOT_PASSWORD=change-this-root-password
AUTH_DB_PORT=3307

AUTH_REDIS_PASSWORD=change-this-redis-password
AUTH_REDIS_PORT=6380
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTIFICATION_TOPIC=notification.events

# Base64-encoded random secret with at least 32 decoded bytes.
# Example: openssl rand -base64 48
JWT_SECRET=replace-with-a-base64-secret
INTERNAL_API_KEY=replace-with-an-internal-api-key

AUTH_SERVICE_PORT=8081
VERIFY_EMAIL_URL=http://localhost:3000/verify-email
RESET_PASSWORD_URL=http://localhost:3000/reset-password
