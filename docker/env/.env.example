# Compose-level settings (read by `docker compose` itself, not injected into containers).
# `docker compose up -d` in this folder loads every file listed in COMPOSE_FILE and merges them into ONE project.
# Remove a file from the list to run without that service.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.common.yml:docker-compose.auth.yml:docker-compose.user.yml:docker-compose.content.yml:docker-compose.gateway.yml

# Host ports (all optional, defaults shown)
# GATEWAY_HOST_PORT=8080
# AUTH_SERVICE_HOST_PORT=8081
# USER_SERVICE_HOST_PORT=8082
# CONTENT_SERVICE_HOST_PORT=8083
# AUTH_DB_HOST_PORT=3307
# USER_DB_HOST_PORT=3308
# CONTENT_DB_HOST_PORT=3309
# REDIS_HOST_PORT=6379
# KAFKA_HOST_PORT=9094
# KEYCLOAK_HOST_PORT=8180
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
