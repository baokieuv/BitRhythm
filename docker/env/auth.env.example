# Loaded by: auth-service (with shared.env + redis.env) and auth-database
# --- auth-service ---
DB_URL=jdbc:mariadb://auth-database:3306/auth_service
DB_USERNAME=auth_service
DB_PASSWORD=change-me-auth-db
JWT_SECRET=change-me-base64-secret-at-least-32-bytes
VERIFY_EMAIL_URL=http://localhost:3000/verify-email
RESET_PASSWORD_URL=http://localhost:3000/reset-password
# --- auth-database (must match DB_USERNAME / DB_PASSWORD above) ---
MARIADB_DATABASE=auth_service
MARIADB_USER=auth_service
MARIADB_PASSWORD=change-me-auth-db
MARIADB_ROOT_PASSWORD=change-me-auth-root
