# Loaded by: auth-service (with shared.env + redis.env) and auth-database
# --- auth-service ---
DB_URL=jdbc:mariadb://auth-database:3306/auth_service
DB_USERNAME=auth_service
DB_PASSWORD=change-me-auth-db
VERIFY_EMAIL_URL=http://localhost:3000/verify-email
RESET_PASSWORD_URL=http://localhost:3000/reset-password
# Initial admin account: always set a real password outside local dev.
ADMIN_PASSWORD=change-me-admin-password

# --- token signing (RS256) + service-to-service auth ---
# "iss" claim. Every service that validates our tokens must use exactly the same value
# (service-auth.resource.issuer / SERVICE_AUTH_RESOURCE_ISSUER).
TOKEN_ISSUER=http://auth-service
JWT_KEY_ID=auth-key-1
# One line each, PEM body only (no BEGIN/END lines). Generate once:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
#   grep -v '^-----' private.pem | tr -d '\n'     -> JWT_PRIVATE_KEY
#   grep -v '^-----' public.pem  | tr -d '\n'     -> JWT_PUBLIC_KEY
#   for windows:
#   powershell -Command "(Get-Content private.pem) -notmatch '^-----' -join ''"
#   powershell -Command "(Get-Content public.pem) -notmatch '^-----' -join ''"
# Left empty = an ephemeral key pair is generated at startup (local dev only: tokens become invalid
# after every restart). Do not commit real keys; use a secret manager outside local dev.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- auth-database (must match DB_USERNAME / DB_PASSWORD above) ---
MARIADB_DATABASE=auth_service
MARIADB_USER=auth_service
MARIADB_PASSWORD=change-me-auth-db
MARIADB_ROOT_PASSWORD=change-me-auth-root