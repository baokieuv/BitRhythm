# Loaded by: content-service (together with shared.env + redis.env). NOT loaded by content-database.
DB_URL=jdbc:mariadb://content-database:3306/content_service
DB_USERNAME=content_service
DB_PASSWORD=change-me-content-db

# --- token validation (tokens issued by auth-service, keys from its JWKS) ---
JWT_JWK_SET_URI=http://auth-service:8081/.well-known/jwks.json
# Must be exactly the "iss" auth-service issues (TOKEN_ISSUER in auth.env)
JWT_ISSUER=http://auth-service
JWT_AUDIENCES=bit-rhythm-api,content-service

# --- MinIO ---
# server side (stat, delete): the docker service name
MINIO_ENDPOINT=http://minio:9000
# the host a BROWSER reaches: presigned upload and streaming URLs are signed with it (not the docker name!)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# credentials: the ones of env/minio.env, or better a dedicated access key limited to the two buckets below
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
# PRIVATE bucket: audio is only reachable through short-lived presigned URLs
AUDIO_BUCKET=music-streaming
# public-read on covers/* only
COVER_BUCKET=music-assets

# --- events (stage 2) ---
CONTENT_EVENTS_TOPIC=content.events
# auth-service must publish USER_DISABLED / USER_DELETED here
AUTH_EVENTS_TOPIC=auth.events

# Loaded by: content-database only
MARIADB_DATABASE=content_service
MARIADB_USER=content_service
MARIADB_PASSWORD=change-me-content-db
MARIADB_ROOT_PASSWORD=change-me-content-root
