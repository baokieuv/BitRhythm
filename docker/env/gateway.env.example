# Loaded by: gateway (together with shared.env)
GATEWAY_PORT=8080
# Service names resolve through service_network
AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
CONTENT_SERVICE_URL=http://content-service:8083
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
GATEWAY_FORWARD_HEADERS=native
GATEWAY_RATE_LIMIT_ENABLED=true

# --- JWT validation (tokens issued by auth-service, RS256, verified with its public keys) ---
# Public keys, fetched lazily on the first token. The default in application.yaml is localhost, which
# does not work inside Docker.
JWT_JWK_SET_URI=http://auth-service:8081/.well-known/jwks.json
# REQUIRED. Must be exactly the "iss" auth-service puts in tokens (TOKEN_ISSUER in auth.env).
JWT_ISSUER=http://auth-service
# "aud" of USER access tokens (auth.token.user-audience in auth-service). Service tokens carry other
# audiences, so the gateway rejects them: only users come in through the gateway.
JWT_AUDIENCES=bit-rhythm-api
# Claim and prefix used to build roles (auth-service writes roles without prefix in the "roles" claim)
JWT_ROLES_CLAIM=roles
JWT_ROLE_PREFIX=ROLE_
GATEWAY_ADMIN_ROLE=ADMIN
# INTERNAL_API_KEY is still required by application.yaml (no default). It must be defined once, in
# shared.env or here, with the same value auth-service gets while it still checks the header.