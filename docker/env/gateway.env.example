# Loaded by: gateway (together with shared.env)
GATEWAY_PORT=8080
# Service names resolve through service_network
AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
CONTENT_SERVICE_URL=http://content-service:8083
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
GATEWAY_FORWARD_HEADERS=native
GATEWAY_RATE_LIMIT_ENABLED=true
