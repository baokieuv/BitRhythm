MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
# minio-setup (aws-cli) credentials: same values as above
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-minio
AWS_DEFAULT_REGION=us-east-1
