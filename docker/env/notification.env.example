# Loaded by: notification-service (together with shared.env + redis.env). NOT loaded by notification-database.
DB_URL=jdbc:mariadb://notification-database:3306/notification_service
DB_USERNAME=notification_service
DB_PASSWORD=change-me-notification-db

# --- token validation (tokens issued by auth-service, keys from its JWKS) ---
JWT_JWK_SET_URI=http://auth-service:8081/.well-known/jwks.json
# Must be exactly the "iss" auth-service issues (TOKEN_ISSUER in auth.env)
JWT_ISSUER=http://auth-service
# users (inbox API) + services (internal API: the caller needs "notification-service" in its allowed audiences)
JWT_AUDIENCES=bit-rhythm-api,notification-service

# --- email provider ---
# smtp  = any SMTP server through MAIL_* below. The default points at mailpit (docker-compose.notification.yml),
#         a fake inbox on http://localhost:8025 that works with no account: use it for local development.
# gmail = real emails through a Gmail account (see the steps below), also fine for demos.
EMAIL_PROVIDER=smtp

# smtp provider
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@bitrhythm.local

# gmail provider. To use it set EMAIL_PROVIDER=gmail and fill the two values:
#   1. Google Account > Security > turn ON 2-Step Verification
#   2. https://myaccount.google.com/apppasswords > create an App Password (16 characters)
#   3. GMAIL_USERNAME = that Gmail address, GMAIL_APP_PASSWORD = the App Password (NOT your account password)
# Emails are always sent FROM GMAIL_USERNAME (MAIL_FROM is ignored). Never commit real values.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# --- events ---
NOTIFICATION_TOPIC=notification.events

# Loaded by: notification-database only
MARIADB_DATABASE=notification_service
MARIADB_USER=notification_service
MARIADB_PASSWORD=change-me-notification-db
MARIADB_ROOT_PASSWORD=change-me-notification-root