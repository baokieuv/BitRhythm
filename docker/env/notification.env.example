# Loaded by: notification-service (with shared.env + redis.env) and notification-database
# --- auth-service ---
DB_URL=jdbc:mariadb://notification-database:3306/notification_service
DB_USERNAME=notification_service
DB_PASSWORD=change-me-auth-db

# --- auth-database (must match DB_USERNAME / DB_PASSWORD above) ---
MARIADB_DATABASE=notification_service
MARIADB_USER=notification_service
MARIADB_PASSWORD=change-me-auth-db
MARIADB_ROOT_PASSWORD=change-me-auth-root