# Loaded by: gateway, auth-service, user-service, content-service
# Values that MUST be identical across services.
INTERNAL_API_KEY=change-me-internal-api-key

# JWT validation (gateway validates tokens issued by auth-service)
# JWT_ISSUER must equal the `iss` claim auth-service puts in tokens.
JWT_ISSUER=http://auth-service:8081
# TODO: adjust to the real JWKS path of auth-service
JWT_JWK_SET_URI=http://auth-service:8081/.well-known/jwks.json
JWT_AUDIENCES=

# Kafka (inside docker network)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
NOTIFICATION_TOPIC=notification.events
