# Loaded by: user-service (together with shared.env). NOT loaded by user-database.
DB_URL=jdbc:mariadb://user-database:3306/user_service
DB_USERNAME=user_service
DB_PASSWORD=change-me-user-db

# --- token validation (tokens issued by auth-service, keys from its JWKS) ---
JWT_JWK_SET_URI=http://auth-service:8081/.well-known/jwks.json
# Must be exactly the "iss" auth-service issues (TOKEN_ISSUER in auth.env)
JWT_ISSUER=http://auth-service
# users + services (internal API: the caller needs "user-service" in its allowed audiences)
JWT_AUDIENCES=bit-rhythm-api,user-service

# --- avatars in MinIO ---
# server side (stat, delete): the docker service name
MINIO_ENDPOINT=http://minio:9000
# the host a BROWSER reaches: presigned upload URLs are signed with it (not the docker name!)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# credentials: the ones of env/minio.env, or better a dedicated access key limited to the user-assets bucket
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
AVATAR_BUCKET=user-assets

# --- events ---
NOTIFICATION_TOPIC=notification.events
# [stage 2] auth-service must publish USER_DELETED / USER_DISABLED here
AUTH_EVENTS_TOPIC=auth.events

# --- auth service ---
AUTH_SERVICE_URL=http://localhost:8081
AUTH_TOKEN_URI=http://localhost:8081/api/auth/token
SERVICE_CLIENT_ID=user-service
SERVICE_CLIENT_SECRET=change-me

# Loaded by: user-database only
MARIADB_DATABASE=user_service
MARIADB_USER=user_service
MARIADB_PASSWORD=change-me-user-db
MARIADB_ROOT_PASSWORD=change-me-user-root

